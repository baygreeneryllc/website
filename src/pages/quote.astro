---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
import { getServices, getPublishedAreas } from '../lib/content';
import { breadcrumbSchema } from '../lib/schema';

const services = await getServices();
const areas = await getPublishedAreas();
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Request a Quote', href: '/quote/' }];

/* Labels sent to the server (must match SERVICES in src/worker/index.ts). */
const serviceOptions = [
  { id: 'landscape-design-build', label: 'Landscape Design & Build' },
  { id: 'landscape-construction', label: 'Landscape Construction' },
  { id: 'irrigation-repair', label: 'Irrigation Repair' },
  { id: 'landscape-repair', label: 'Landscape Repair' },
  { id: 'landscape-maintenance', label: 'Landscape Maintenance' },
  { id: 'cleanup-restoration', label: 'Cleanup & Restoration' },
  { id: 'consultations', label: 'Consultation' },
];
const knownIds = new Set(services.map((s) => s.id));
const options = serviceOptions.filter((o) => knownIds.has(o.id));
const cities = [...new Set(['San Jose', 'Almaden Valley', 'Cupertino', 'Campbell', 'Los Gatos', 'Saratoga', 'Sunnyvale', 'Santa Clara', 'Mountain View', 'Los Altos', 'Los Altos Hills', 'Palo Alto', 'Menlo Park', 'Atherton', 'Ladera', 'Portola Valley', 'Woodside', ...areas.map((a) => a.data.name)])].sort();
---
<BaseLayout
  title="Request a Landscaping Quote | Bay Greenery"
  description="Request a quote from Bay Greenery, a licensed landscape contractor in the South Bay and Peninsula. Tell us about your project and add photos."
  schema={[breadcrumbSchema(crumbs)]}
>
  <main class="page-main">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1 class="page-title">Request a Quote</h1>
      <p class="page-lead">Tell us about your project and we'll get back to you as soon as we can. Prefer to talk? Call <a href={`tel:${site.phoneTel}`}>{site.phone}</a>.</p>

      <form id="quote-form" class="quote-form" action="/api/quote" method="post" enctype="multipart/form-data" novalidate data-sitekey={site.turnstileSiteKey}>
        <div class="form-grid">
          <label class="form-field">
            <span>Name <em>*</em></span>
            <input name="name" type="text" autocomplete="name" required maxlength="100">
          </label>
          <label class="form-field">
            <span>Phone <em>*</em></span>
            <input name="phone" type="tel" autocomplete="tel" required maxlength="40">
          </label>
          <label class="form-field">
            <span>Email <em>*</em></span>
            <input name="email" type="email" autocomplete="email" required maxlength="200">
          </label>
          <label class="form-field">
            <span>City or neighborhood <em>*</em></span>
            <input name="city" type="text" list="quote-cities" autocomplete="address-level2" required maxlength="100" placeholder="e.g. San Jose">
            <datalist id="quote-cities">{cities.map((c) => <option value={c} />)}</datalist>
          </label>
          <label class="form-field form-field-wide">
            <span>Service needed</span>
            <select name="service" id="quote-service">
              {options.map((o) => <option value={o.label} data-id={o.id}>{o.label}</option>)}
              <option value="Not sure / Other" selected>Not sure / Other</option>
            </select>
          </label>
          <label class="form-field form-field-wide">
            <span>Tell us about your project <em>*</em></span>
            <textarea name="description" rows="6" required maxlength="5000" placeholder="What would you like done? Rough size of the area, timing, anything else we should know."></textarea>
          </label>

          <div class="form-field form-field-wide">
            <span id="photos-label">Photos (optional, up to 10)</span>
            <div id="photo-drop" class="photo-drop">
              <label class="photo-drop-button">
                <input id="quote-photos" type="file" accept="image/*" multiple aria-labelledby="photos-label">
                Choose photos
              </label>
              <span class="photo-drop-text">or drag them here. Photos of the area help us give a more accurate quote.</span>
            </div>
            <p id="photo-message" class="photo-message" aria-live="polite" hidden></p>
            <ul id="photo-list" class="photo-list"></ul>
          </div>

          <fieldset class="form-field form-field-wide">
            <legend>Best way to reach you</legend>
            <div class="radio-row">
              <label><input type="radio" name="contact_method" value="Phone call" checked> Phone call</label>
              <label><input type="radio" name="contact_method" value="Text message"> Text message</label>
              <label><input type="radio" name="contact_method" value="Email"> Email</label>
            </div>
          </fieldset>

          <label class="form-field form-field-wide">
            <span>How did you hear about us? (optional)</span>
            <select name="heard_about">
              <option value="">Choose one</option>
              <option>Google search</option>
              <option>Google Maps</option>
              <option>Referral from a friend or neighbor</option>
              <option>Saw our work in the neighborhood</option>
              <option>Yelp</option>
              <option>Nextdoor</option>
              <option>Other</option>
            </select>
          </label>

          <!-- Spam trap: hidden from people, bots fill it in. -->
          <div class="hp-field" aria-hidden="true">
            <label>Company website <input name="company_website" type="text" tabindex="-1" autocomplete="off"></label>
          </div>
        </div>

        <div id="turnstile" class="turnstile-box"></div>
        <p id="form-error" class="form-error" role="alert" hidden></p>
        <button id="quote-submit" class="cta-button" type="submit">Send Request &rarr;</button>
        <p class="form-note">By sending this form you agree we may contact you about your project. We never share your information.</p>
        <noscript><p class="form-error">This form needs JavaScript. Please call {site.phone} or email {site.email}.</p></noscript>
      </form>

      <div id="quote-thanks" class="quote-thanks" hidden tabindex="-1">
        <h2>Thank you! Your request was sent.</h2>
        <p>We'll be in touch as soon as we can. If it's urgent, call <a href={`tel:${site.phoneTel}`}>{site.phone}</a>.</p>
        <p><a href="/projects/">Browse our recent projects &rarr;</a></p>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement;
  const submit = document.getElementById('quote-submit') as HTMLButtonElement;
  const errorBox = document.getElementById('form-error') as HTMLParagraphElement;
  const thanks = document.getElementById('quote-thanks') as HTMLDivElement;
  const photosInput = document.getElementById('quote-photos') as HTMLInputElement;
  const photoList = document.getElementById('photo-list') as HTMLUListElement;
  const serviceSelect = document.getElementById('quote-service') as HTMLSelectElement;
  const MAX_PHOTOS = 10;
  const MAX_EDGE = 2000; // px, longest side after resizing

  // Pre-select the service when arriving from a service page (?service=irrigation-repair).
  const wanted = new URLSearchParams(location.search).get('service');
  if (wanted) {
    const opt = Array.from(serviceSelect.options).find((o) => o.dataset.id === wanted);
    if (opt) serviceSelect.value = opt.value;
  }

  // Spam check (Cloudflare Turnstile). Uses Cloudflare's always-pass test key on localhost.
  const isLocal = ['localhost', '127.0.0.1'].includes(location.hostname);
  const sitekey = isLocal ? '1x00000000000000000000AA' : form.dataset.sitekey!;
  const ts = document.createElement('script');
  ts.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
  ts.async = true;
  ts.onload = () => (window as any).turnstile?.render('#turnstile', { sitekey, theme: 'light' });
  document.head.appendChild(ts);

  /* Attached photos are kept here, so choosing or dragging more photos
     adds to the list instead of replacing it. Each has a remove (×) button. */
  const dropZone = document.getElementById('photo-drop') as HTMLDivElement;
  const photoMessage = document.getElementById('photo-message') as HTMLParagraphElement;
  type Attached = { file: File; url: string };
  let attached: Attached[] = [];

  const sameFile = (a: File, b: File) => a.name === b.name && a.size === b.size && a.lastModified === b.lastModified;
  const isImage = (f: File) => f.type.startsWith('image/') || /\.(heic|heif)$/i.test(f.name);
  const formatSize = (bytes: number) => (bytes >= 1024 * 1024 ? `${(bytes / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`);

  function addPhotos(files: File[]) {
    const notes: string[] = [];
    const notImages = files.filter((f) => !isImage(f));
    if (notImages.length) notes.push(`${notImages.length === 1 ? `"${notImages[0].name}" isn't a photo` : `${notImages.length} files aren't photos`} and ${notImages.length === 1 ? 'wasn\'t' : 'weren\'t'} added.`);
    let skipped = 0;
    for (const f of files.filter(isImage)) {
      if (attached.some((a) => sameFile(a.file, f))) continue; // already attached
      if (attached.length >= MAX_PHOTOS) { skipped++; continue; }
      attached.push({ file: f, url: URL.createObjectURL(f) });
    }
    if (skipped) notes.push(`You can attach up to ${MAX_PHOTOS} photos. ${skipped} ${skipped === 1 ? 'photo wasn\'t' : 'photos weren\'t'} added.`);
    photoMessage.textContent = notes.join(' ');
    photoMessage.hidden = notes.length === 0;
    renderPhotos();
  }

  function removePhoto(index: number) {
    URL.revokeObjectURL(attached[index].url);
    attached.splice(index, 1);
    photoMessage.hidden = true;
    renderPhotos();
  }

  function renderPhotos() {
    photoList.innerHTML = '';
    attached.forEach((a, i) => {
      const li = document.createElement('li');
      const thumb = document.createElement('img');
      thumb.src = a.url;
      thumb.alt = '';
      thumb.className = 'photo-thumb';
      thumb.onerror = () => thumb.remove(); // e.g. HEIC preview not supported
      const name = document.createElement('span');
      name.className = 'photo-name';
      name.textContent = a.file.name;
      const size = document.createElement('span');
      size.className = 'photo-size';
      size.textContent = formatSize(a.file.size);
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'photo-remove';
      remove.setAttribute('aria-label', `Remove ${a.file.name}`);
      remove.textContent = '×';
      remove.addEventListener('click', () => removePhoto(i));
      li.append(thumb, name, size, remove);
      photoList.appendChild(li);
    });
    dropZone.classList.toggle('is-full', attached.length >= MAX_PHOTOS);
  }

  photosInput.addEventListener('change', () => {
    addPhotos(Array.from(photosInput.files ?? []));
    photosInput.value = ''; // allow choosing the same photo again after removing it
  });

  // Drag and drop onto the photo box.
  ['dragenter', 'dragover'].forEach((type) =>
    dropZone.addEventListener(type, (e) => {
      e.preventDefault();
      dropZone.classList.add('is-dragover');
    }),
  );
  ['dragleave', 'dragend'].forEach((type) =>
    dropZone.addEventListener(type, (e) => {
      const to = (e as DragEvent).relatedTarget as Node | null;
      if (!to || !dropZone.contains(to)) dropZone.classList.remove('is-dragover');
    }),
  );
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('is-dragover');
    addPhotos(Array.from((e as DragEvent).dataTransfer?.files ?? []));
  });
  // A photo dropped just outside the box shouldn't open in the browser and lose the form.
  window.addEventListener('dragover', (e) => e.preventDefault());
  window.addEventListener('drop', (e) => e.preventDefault());

  /* Shrink photos in the browser before upload: faster on phones, and
     re-encoding removes location (GPS) and camera data. */
  async function shrink(file: File): Promise<Blob> {
    try {
      const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' } as ImageBitmapOptions);
      const scale = Math.min(1, MAX_EDGE / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close();
      const blob = await new Promise<Blob | null>((r) => canvas.toBlob(r, 'image/jpeg', 0.82));
      return blob ?? file;
    } catch {
      return file; // e.g. a format this browser can't decode; send as-is
    }
  }

  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.hidden = false;
    errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.hidden = true;
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    if (!isLocal && !data.get('cf-turnstile-response')) {
      showError('Please complete the spam check above the Send button.');
      return;
    }

    submit.disabled = true;
    submit.textContent = 'Sending…';
    try {
      data.delete('photos');
      const files = attached.map((a) => a.file).slice(0, MAX_PHOTOS);
      for (const [i, f] of files.entries()) {
        submit.textContent = `Preparing photo ${i + 1} of ${files.length}…`;
        const blob = await shrink(f);
        const name = blob === f ? f.name : `photo-${i + 1}.jpg`;
        data.append('photos', blob, name);
      }
      submit.textContent = 'Sending…';
      const res = await fetch('/api/quote', { method: 'POST', body: data });
      const out = await res.json().catch(() => ({ ok: false, error: '' }));
      if (!res.ok || !out.ok) throw new Error(out.error || 'Something went wrong. Please try again or call us.');
      form.hidden = true;
      thanks.hidden = false;
      thanks.focus();
      (window as any).gtag?.('event', 'generate_lead', { form: 'quote' });
    } catch (err) {
      showError((err as Error).message);
      (window as any).turnstile?.reset('#turnstile');
    } finally {
      submit.disabled = false;
      submit.innerHTML = 'Send Request &rarr;';
    }
  });
</script>
