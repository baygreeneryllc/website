---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import { getPublishedAreas, getAllAreas, getProjects, getServices, projectsInArea, type Area } from '../../lib/content';
import { breadcrumbSchema, businessId } from '../../lib/schema';
import { absoluteUrl } from '../../data/site';
import { gallery } from '../../data/gallery';

export async function getStaticPaths() {
  const areas = await getPublishedAreas();
  return areas.map((area) => ({ params: { id: area.id }, props: { area } }));
}

const { area } = Astro.props as { area: Area };
const { Content } = await render(area);
const all = await getAllAreas();
const published = await getPublishedAreas();
const projects = projectsInArea(area, await getProjects(), all);
const services = await getServices();
const usedServices = services.filter((s) => projects.some((p) => p.data.services.some((r) => r.id === s.id)));
const parent = area.data.parent ? all.find((a) => a.id === area.data.parent!.id) : undefined;
const children = published.filter((a) => a.data.parent?.id === area.id);
const nearby = published.filter((a) => a.id !== area.id && a.id !== parent?.id && !children.includes(a));

const areaIds = new Set([area.id, ...children.map((c) => c.id)]);
const areaPhotos = [...projects.flatMap((p) => p.data.photos.filter((ph) => !ph.area || areaIds.has(ph.area.id))), ...gallery.filter((g) => g.area && areaIds.has(g.area))];

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Service Areas', href: '/areas/' },
  ...(parent ? [{ name: parent.data.name, href: `/areas/${parent.id}/` }] : []),
  { name: area.data.name, href: `/areas/${area.id}/` },
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `Landscaping in ${area.data.name}`,
    url: absoluteUrl(`/areas/${area.id}/`),
    description: area.data.description,
    about: { '@id': businessId },
    spatialCoverage: { '@type': 'Place', name: area.data.locality.includes(area.data.name) ? area.data.locality : `${area.data.name}, ${area.data.locality}` },
  },
  breadcrumbSchema(crumbs),
];
---
<BaseLayout title={area.data.seoTitle} description={area.data.description} image={areaPhotos[0]?.src} imageAlt={areaPhotos[0]?.alt} schema={schema}>
  <main class="page-main">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1 class="page-title">Landscaping in {area.data.name}</h1>
      <p class="page-lead">{area.data.locality}{parent && <> · part of <a href={`/areas/${parent.id}/`}>{parent.data.name}</a></>}</p>

      <div class="prose"><Content /></div>

      <section class="page-section">
        <h2>Our work in {area.data.name}</h2>
        <ProjectGallery projects={projects} allAreas={all} publishedAreas={published} services={services} area={area} />
      </section>

      <section class="page-section">
        <h2>Our services in {area.data.name}</h2>
        <ul class="tag-list">
          {(usedServices.length ? usedServices : services).map((s) => <li><a href={`/services/${s.id}/`}>{s.data.title}</a></li>)}
        </ul>
        <p>We offer <a href="/services/">all of our services</a> in {area.data.name}, including <a href="/services/irrigation-repair/">irrigation repair</a> and <a href="/services/landscape-design-build/">landscape design and build</a>.</p>
      </section>

      <CtaPanel heading={`Planning a project in ${area.data.name}?`} />

      {nearby.length > 0 && (
        <section class="page-section">
          <h2>Nearby areas we serve</h2>
          <ul class="tag-list">{nearby.map((a) => <li><a href={`/areas/${a.id}/`}>{a.data.name}</a></li>)}</ul>
        </section>
      )}
    </div>
  </main>
</BaseLayout>
