---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectsSidebar from '../../components/ProjectsSidebar.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import GalleryTile from '../../components/GalleryTile.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { gallery } from '../../data/gallery';
import { getProjects, getAllAreas } from '../../lib/content';
import { breadcrumbSchema, businessId } from '../../lib/schema';
import { absoluteUrl } from '../../data/site';

const projects = await getProjects();
const areas = await getAllAreas();
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Projects', href: '/projects/' }];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Bay Greenery Project Gallery',
    url: absoluteUrl('/projects/'),
    description: 'Recent landscape projects by Bay Greenery across the South Bay and Peninsula.',
    about: { '@id': businessId },
    hasPart: projects.map((p) => ({ '@type': 'WebPage', name: p.data.title, url: absoluteUrl(`/projects/${p.id}/`) })),
  },
  breadcrumbSchema(crumbs),
];
---
<BaseLayout
  title="Landscape Project Gallery: San Jose & Peninsula | Bay Greenery"
  description="Recent Bay Greenery landscape projects in San Jose, Almaden Valley, Ladera, Portola Valley, and Campbell: remodels, retaining walls, irrigation, lighting, and more."
  image={gallery[1].src}
  imageAlt={gallery[1].alt}
  schema={schema}
>
  <div class="portfolio-layout">
    <ProjectsSidebar projects={projects} />

    <main class="portfolio-content">
      <section class="portfolio-section is-active">
        <Breadcrumbs items={crumbs} />
        <div class="portfolio-section-head">
          <h1>Project Gallery</h1>
          <p class="portfolio-section-lead">A walk through our recent endeavours across the South Bay and Peninsula. Choose a project for the full story and before-and-after photos, or browse every photo below.</p>
        </div>

        <div class="card-grid">
          {projects.map((p) => <ProjectCard project={p} areas={areas} />)}
        </div>

        <div class="page-section">
          <h2>All Photos</h2>
          <p>Click any photo to view it full size and arrow through.</p>
          <div class="gallery-grid">
            {gallery.map((g) => <GalleryTile src={g.src} alt={g.alt} />)}
          </div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
