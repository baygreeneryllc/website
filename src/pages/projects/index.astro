---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { getProjects, getAllAreas, getPublishedAreas, getServices, coverOf } from '../../lib/content';
import { breadcrumbSchema, businessId } from '../../lib/schema';
import { absoluteUrl } from '../../data/site';
import { gallery } from '../../data/gallery';

const projects = await getProjects();
const [allAreas, publishedAreas, services] = await Promise.all([getAllAreas(), getPublishedAreas(), getServices()]);
const share = projects[0] ? coverOf(projects[0]) : gallery[1];
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Projects', href: '/projects/' }];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Bay Greenery Project Gallery',
    url: absoluteUrl('/projects/'),
    description: 'Recent landscape projects by Bay Greenery across the South Bay and Peninsula.',
    about: { '@id': businessId },
    hasPart: projects.map((p) => ({ '@type': 'WebPage', name: p.data.title, url: absoluteUrl(`/projects/${p.id}/`) })),
  },
  breadcrumbSchema(crumbs),
];
---
<BaseLayout
  title="Landscape Project Gallery: San Jose & Peninsula | Bay Greenery"
  description="Recent Bay Greenery landscape projects in San Jose, Almaden Valley, Ladera, Portola Valley, and Campbell: remodels, retaining walls, irrigation, lighting, and more."
  image={share.src}
  imageAlt={share.alt}
  schema={schema}
>
  <main class="page-main">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1 class="page-title">Project Gallery</h1>
      <p class="page-lead pg-lead">Recent work across the South Bay and Peninsula. Browse whole projects, see the finished results, or find a feature you want for your own yard.</p>

      <ProjectGallery projects={projects} allAreas={allAreas} publishedAreas={publishedAreas} services={services} />

      <CtaPanel heading="Like what you see?" />
    </div>
  </main>
</BaseLayout>
