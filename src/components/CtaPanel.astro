---
import { site } from '../data/site';
interface Props { heading?: string; text?: string; service?: string }
const { heading = 'Ready to get started?', text = `Tell us about your project. Submit your request online or call ${site.phone}.`, service } = Astro.props;
const href = service ? `${site.bookingFormUrl}?service=${service}` : site.bookingFormUrl;
---
<aside class="cta-panel">
  <div>
    <h2>{heading}</h2>
    <p>{text}</p>
  </div>
  <a class="cta-button" href={href}>Request a Quote &rarr;</a>
</aside>
