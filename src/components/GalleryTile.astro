---
/* A clickable photo tile that opens the lightbox. Renders a real <img>
   (optimized, with alt text) so search engines can index the photo. */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  label?: string;
  eager?: boolean;
}
const { src, alt, label, eager = false } = Astro.props;
const full = await getImage({ src, width: 1400, format: 'webp', quality: 70 });
const labelClass = label === 'After' ? 'is-after' : label === 'During' ? 'is-during' : '';
---
<button class="gallery-tile" type="button" data-src={full.src} aria-label={alt}>
  <Image src={src} alt={alt} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 400px" format="webp" quality={75} loading={eager ? 'eager' : 'lazy'} />
  {label && <span class={`gallery-tile-label ${labelClass}`}>{label}</span>}
</button>
