---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site, browserConfig, absoluteUrl } from '../data/site';
import { heroPhoto } from '../data/gallery';
import { getServices, getPublishedAreas } from '../lib/content';

interface Props {
  title: string;
  description: string;
  /* Photo used for social sharing previews. */
  image?: ImageMetadata;
  imageAlt?: string;
  /* Structured data objects (schema.org) for this page. */
  schema?: object[];
  /* Home page has its own hero instead of the slim header. */
  isHome?: boolean;
  noindex?: boolean;
}

const { title, description, image = heroPhoto, imageAlt = 'Landscape project by Bay Greenery', schema = [], isHome = false, noindex = false } = Astro.props;

const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = await getImage({ src: image, width: 1200, format: 'jpeg', quality: 80 });
const services = await getServices();
const areas = (await getPublishedAreas()).filter((a) => !a.data.parent);
const path = Astro.url.pathname;
const current = (prefix: string) => (path.startsWith(prefix) ? 'page' : undefined);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}

  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content={site.name}>
  <meta property="og:image" content={absoluteUrl(ogImage.src)}>
  <meta property="og:image:width" content={String(ogImage.attributes.width)}>
  <meta property="og:image:height" content={String(ogImage.attributes.height)}>
  <meta property="og:image:alt" content={imageAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={absoluteUrl(ogImage.src)}>

  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="preload" href="/fonts/Harabara.ttf" as="font" type="font/ttf" crossorigin>

  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

  <script is:inline set:html={`window.BAY_GREENERY_CONFIG = ${JSON.stringify(browserConfig)};`} />
  <slot name="head" />
</head>
<body>
  {!isHome && (
    <header class="page-header">
      <div class="container page-header-row">
        <a class="page-logo" href="/"><img src="/images/logo-baygreenery.png" alt="Bay Greenery home" width="148" height="44"></a>
        <nav class="site-nav" aria-label="Main">
          <a href="/services/" aria-current={current('/services/')}>Services</a>
          <a href="/projects/" aria-current={current('/projects/')}>Projects</a>
          <a href="/areas/" aria-current={current('/areas/')}>Areas</a>
          <a class="site-nav-cta js-booking-link" href={site.bookingFormUrl}>Book a Service</a>
        </nav>
      </div>
    </header>
  )}

  <slot />

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">

        <div class="footer-block">
          <h3>Get in Touch</h3>
          <a class="js-email-link" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="js-phone-link" href={`tel:${site.phoneTel}`}>{site.phone}</a>

          <h4>Mailing Address</h4>
          <address class="footer-mailing-address">{site.mailingAddress.map((line, i) => <>{i > 0 && <br />}{line}</>)}</address>
        </div>

        <div class="footer-block">
          <h3>Services</h3>
          {services.map((s) => <a class="footer-sublink" href={`/services/${s.id}/`}>{s.data.title}</a>)}
        </div>

        <div class="footer-block">
          <h3>Service Area</h3>
          <p>{site.serviceArea.join(' • ')}</p>
          {areas.map((a) => <a class="footer-sublink" href={`/areas/${a.id}/`}>{a.data.name}</a>)}
        </div>

        <div class="footer-block">
          <h3>Get Started</h3>
          <a class="js-booking-link" href={site.bookingFormUrl}>Book a Service &rarr;</a>
          <a href="/projects/">Project Gallery &rarr;</a>
          {site.googleReviewsUrl && <a class="js-reviews-link" href={site.googleReviewsUrl}>Google Reviews &rarr;</a>}
        </div>

      </div>

      <div class="footer-license">{site.license}</div>
      <div class="footer-bonded">{site.bondedAndInsured}</div>
    </div>
  </footer>

  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
